# Copy to .env.local and fill in from:
# firebase apps:sdkconfig WEB <app-id> --project sdemo-5cbcd
#
# .env.local is gitignored (the *.local pattern) so these values never
# reach the repository. See NFR-002 in rfp/firebase-google-signin-roles/requirements.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
